{
  "config": {
    "step": {
      "user": {
        "title": "Connect your Hoymiles HiOne",
        "description": "Enter the address of the Hoymiles DTS / Modbus TCP gateway.\n\n**Only one Modbus client can talk to the HiOne at a time.** Remove any `modbus:` YAML hub, EVCC, Node-RED or other tool that connects to the same gateway before continuing, otherwise responses get mixed up.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Modbus unit ID",
          "framer": "Protocol",
          "layout": "Hardware generation"
        },
        "data_description": {
          "host": "IP address or hostname of the Modbus gateway (DTS stick or RS485 converter).",
          "port": "Usually 502.",
          "unit_id": "Usually 1.",
          "framer": "Use Modbus TCP unless your RS485 gateway runs in transparent (RTU over TCP) mode.",
          "layout": "HiOne uses the G3 layout. Choose G1/G2 only for older Hoymiles hybrid inverters."
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "Update the connection details. The device must stay the same.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Modbus unit ID",
          "framer": "Protocol",
          "layout": "Hardware generation"
        },
        "data_description": {
          "host": "IP address or hostname of the Modbus gateway (DTS stick or RS485 converter).",
          "port": "Usually 502.",
          "unit_id": "Usually 1.",
          "framer": "Use Modbus TCP unless your RS485 gateway runs in transparent (RTU over TCP) mode.",
          "layout": "HiOne uses the G3 layout. Choose G1/G2 only for older Hoymiles hybrid inverters."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect. Check the address and make sure no other Modbus client is connected.",
      "not_supported": "The device answered, but not like a Hoymiles storage system. Check the unit ID.",
      "unknown": "Unexpected error, see the logs."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "reconfigure_successful": "The connection was updated.",
      "wrong_device": "This address belongs to a different device."
    }
