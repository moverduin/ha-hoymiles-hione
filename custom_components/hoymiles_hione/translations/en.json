  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "**Write access** adds controls for the EMS mode and battery settings, and enables the `hoymiles_hione.set_ems` action.\n\nWriting changes how your battery charges from and discharges to the grid. Every write is stored in the device's flash memory, so only change settings when needed (not every few seconds). You use these controls at your own risk.",
        "data": {
          "scan_interval": "Polling interval",
          "enable_controls": "Enable write access (controls)"
        },
        "data_description": {
          "scan_interval": "How often all values are read. 30 seconds is a good default.",
          "enable_controls": "Off by default. Read the safety notes in the README first."
        }
      }
    }
  },
