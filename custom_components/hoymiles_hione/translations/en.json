  "services": {
    "set_ems": {
      "name": "Set EMS settings",
      "description": "Change the EMS mode and/or its settings in one write. The current block is read and checked first; unchanged values are not written. Requires write access.",
      "fields": {
        "config_entry_id": {
          "name": "Device",
          "description": "The HiOne to change."
        },
        "ems_mode": {
          "name": "EMS mode",
          "description": "Operating mode. Pure off-grid cannot be set remotely."
        },
        "self_use_reserve_soc": {
          "name": "Self-use reserve SOC",
          "description": "Battery level kept in reserve in self-use mode. Setting it above the current level makes the HiOne charge from the grid."
        },
        "backup_reserve_soc": {
          "name": "Backup reserve SOC",
          "description": "Battery level kept in reserve in backup mode."
        },
        "economic_reserve_soc": {
          "name": "Economic mode reserve SOC",
          "description": "Battery level kept in reserve in economic mode."
        },
        "force_charge_target_soc": {
          "name": "Force charge target SOC",
          "description": "Charge until this level in force charge mode."
        },
        "force_charge_power": {
          "name": "Force charge power",
          "description": "Charge power in force charge mode, as a percentage of the maximum."
        },
        "force_discharge_target_soc": {
          "name": "Force discharge target SOC",
          "description": "Discharge until this level in force discharge mode."
        },
        "force_discharge_power": {
          "name": "Force discharge power",
          "description": "Discharge power in force discharge mode, as a percentage of the maximum."
        }
      }
